# Call Center Agent - copy this file to ".env" (project root) and edit.
# Everything is optional: the app runs out of the box on SQLite with the built-in knowledge base.

APP_NAME=Call Center Agent
DEBUG=false

# --- Database (SQLite file inside ./data by default) ---
# DATABASE_URL=sqlite:///data/call_center.db

# --- Security ---
# Leave empty to auto-generate a key stored in data/.secret_key
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# First superadmin (created only once, on first start). If the password is empty a random one is printed in the console.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=

# --- Server ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Public HTTPS address Vonage can reach (needed only for follow-up calls), e.g. an ngrok URL
PUBLIC_BASE_URL=http://localhost:8000
# Only needed if the pages are served from another origin (comma separated)
ALLOWED_ORIGINS=

# Load a few sample knowledge-base articles on the very first start
SEED_SAMPLE_KB=true

# --- AI (optional) ---
# OpenRouter: the Agent's language model (rewrites KB answers in the chosen persona's tone)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional: your site URL, shown on OpenRouter's rankings
OPENROUTER_REFERER=
# Groq: speech only (voice messages = speech-to-text, spoken replies = text-to-speech)
GROQ_API_KEY=
WHISPER_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=ar
GROQ_TTS_MODEL=playai-tts-arabic
GROQ_TTS_VOICE=Ahmad-PlayAI
# Tavily: web-search fallback when the KB has no answer (needs OPENROUTER_API_KEY too)
TAVILY_API_KEY=
# 0..1 - how much of the question must be covered by a KB article to answer from it
KB_CONFIDENCE_THRESHOLD=0.45

# --- Semantic search (optional, local; needs: pip install -r backend/requirements-ai.txt) ---
# none  = keyword search (BM25) only.   local = BM25 + embeddings (hybrid), models run on this machine.
EMBEDDING_PROVIDER=none
# Multilingual (Arabic works): intfloat/multilingual-e5-small (small, fast)  or  BAAI/bge-m3 (better, larger)
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
# sqlite = vectors stored in the same SQLite file (no extra service).   qdrant = use a Qdrant server.
VECTOR_STORE=sqlite
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=call_center_kb
# Minimum cosine similarity to trust a semantic match. 0 = automatic (0.80 for e5 models, 0.55 for bge). TUNE ON YOUR DATA.
VECTOR_MIN_SCORE=0
# Cross-encoder reranker (local, optional, slower): re-orders the hybrid candidates
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_MIN_SCORE=0.35
HYBRID_CANDIDATES=10
HYBRID_BM25_WEIGHT=1.0
HYBRID_VECTOR_WEIGHT=1.0

# --- Follow-up phone calls (optional, Vonage Voice API) ---
FOLLOWUP_PROVIDER=none          # none | vonage
FOLLOWUP_DELAY_SECONDS=180
FOLLOWUP_RETRY_DELAY_SECONDS=300
FOLLOWUP_MAX_ATTEMPTS=2
FOLLOWUP_CALL_TIMEOUT_SECONDS=600
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY_PATH=./private.key
VONAGE_FROM_NUMBER=
# While testing, every call goes to this number instead of the customer's
VONAGE_TEST_TO_NUMBER=

# --- Login brute-force protection ---
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=300
